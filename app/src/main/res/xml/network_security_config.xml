<?xml version="1.0" encoding="utf-8"?>
<!-- 订阅地址由用户自行填写，局域网 http:// 服务端也要能用；公网仍优先建议 https。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
